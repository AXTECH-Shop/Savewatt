{
  "name": "savewatt-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:worker": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2022 --packages=external --alias:server-only=./vendor/server-only/index.js --alias:@=../savewatt-platform/src --outfile=dist/index.js",
    "deploy": "wrangler deploy",
    "test": "node --experimental-sqlite --experimental-transform-types --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./test/register-loader.mjs --test --test-concurrency=1 test/auth.test.mjs test/tools.test.mjs test/oauth.test.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "server-only": "file:vendor/server-only"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "wrangler": "^4.132.0"
  }
}
