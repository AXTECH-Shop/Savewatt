# Savewatt platform — environment (non-secret template)
# Copy to .env.local and fill. Clerk keys are pulled by the Clerk CLI (`clerk env pull`)
# and MUST NOT be committed. Do not put secrets in this file.

# --- Vertex AI Gemini (bill OCR extraction, EU multi-region, GCP credits) ---
# Keyless: the Worker signs an OIDC JWT exchanged via Workload Identity Federation
# (pool savewatt-workers / provider savewatt-platform). API keys and SA keys are
# blocked by the org policy. GCP_WIF_PRIVATE_KEY is a Worker secret (PEM, \n-escaped here).
VERTEX_PROJECT_ID=project-f5aa049c-0f7c-40c8-bf5
VERTEX_LOCATION=eu
# GCP_WIF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Extraction model. Override only with a model available on Vertex in VERTEX_LOCATION.
GEMINI_MODEL=gemini-3.6-flash

# --- Clerk (managed by `clerk env pull` → .env.local; shown here for reference only) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...            # NEVER commit

# --- DocuSeal (prefer EU Cloud or an EU-hosted instance) ---
DOCUSEAL_BASE_URL=https://api.docuseal.eu
DOCUSEAL_SIGN_URL=https://docuseal.eu
NEXT_PUBLIC_DOCUSEAL_EMBED_HOST=cdn.docuseal.eu
DOCUSEAL_TEMPLATE_ID=123456
# DOCUSEAL_API_TOKEN=                    # secret
# DOCUSEAL_WEBHOOK_SECRET=               # whsec_... from DocuSeal webhook security
# DOCUSEAL_SOURCE_CONFIRMED_SANITIZED=true # local upload script safety gate

# --- Giftogram (sandbox first; keep secrets server-side only) ---
GIFTOGRAM_BASE_URL=https://api.giftogram.com/api/v1
GIFTOGRAM_CAMPAIGN_ID=your-api-campaign-uuid
# GIFTOGRAM_API_KEY=                     # secret Authorization header value
# GIFTOGRAM_WEBHOOK_SECRET=              # client secret for HMAC-SHA256 verification

# Local role walkthrough only. Never enable in a deployed environment.
# NEXT_PUBLIC_SAVEWATT_DEMO_MODE=true

# Transactional email (proposal delivery, follow-ups) — Cloudflare Email Service
# `send_email` binding EMAIL (wrangler.jsonc). No secret; savewatt.fr must be
# onboarded under Email Service > Email Sending.

# Lead follow-up sweep (notifications engine). POST /api/cron/followups is
# guarded by a Bearer token because OpenNext/Cloudflare cannot register a
# native `scheduled` handler — point an external scheduler (Cloudflare Cron
# Worker or HTTPS cron) at it once a day.
# CRON_SECRET=                         # random 32+ chars; Cloudflare Worker secret
# FOLLOWUPS_STALE_LEAD_DAYS=3          # days without activity before a NEW lead is flagged
# FOLLOWUPS_SEND_STATUS_EMAILS=false   # "true" also emails dossier owners on status changes

# Customer offer portal (/portal/offer/[token]) — HMAC-SHA256 secret for the
# stateless signed viewing links (src/lib/portal/portal-token.ts). Random,
# min 16 chars (use 32+); set as a Cloudflare Worker secret in production.
# Missing/weak secret → server error; unsigned tokens are never issued.
# PORTAL_TOKEN_SECRET=

# Server-side offer PDF rendering — Cloudflare Browser Rendering binding (configured in wrangler.jsonc)
