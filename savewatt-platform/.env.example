# Savewatt platform — environment (non-secret template)
# Copy to .env.local and fill. Clerk keys are pulled by the Clerk CLI (`clerk env pull`)
# and MUST NOT be committed. Do not put secrets in this file.

# --- Gemini API (bill OCR extraction) ---
# Use a restricted API key. Set it as a Cloudflare Worker secret in production.
GOOGLE_API_KEY=
# Extraction model. Override only with a model available to this API key.
GEMINI_MODEL=gemini-3.6-flash

# --- Clerk (managed by `clerk env pull` → .env.local; shown here for reference only) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...            # NEVER commit

# --- DocuSeal (prefer EU Cloud or an EU-hosted instance) ---
DOCUSEAL_BASE_URL=https://api.docuseal.eu
DOCUSEAL_SIGN_URL=https://docuseal.eu
NEXT_PUBLIC_DOCUSEAL_EMBED_HOST=cdn.docuseal.eu
DOCUSEAL_TEMPLATE_ID=123456
# DOCUSEAL_API_TOKEN=                    # secret
# DOCUSEAL_WEBHOOK_SECRET=               # whsec_... from DocuSeal webhook security
# DOCUSEAL_SOURCE_CONFIRMED_SANITIZED=true # local upload script safety gate

# --- Giftogram (sandbox first; keep secrets server-side only) ---
GIFTOGRAM_BASE_URL=https://api.giftogram.com/api/v1
GIFTOGRAM_CAMPAIGN_ID=your-api-campaign-uuid
# GIFTOGRAM_API_KEY=                     # secret Authorization header value
# GIFTOGRAM_WEBHOOK_SECRET=              # client secret for HMAC-SHA256 verification

# Local role walkthrough only. Never enable in a deployed environment.
# NEXT_PUBLIC_SAVEWATT_DEMO_MODE=true

# Transactional email (proposal delivery) — Resend
RESEND_API_KEY=

# Server-side offer PDF rendering — Cloudflare Browser Rendering binding (configured in wrangler.jsonc)
