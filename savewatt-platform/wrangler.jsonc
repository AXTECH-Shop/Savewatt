{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "savewatt-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "app.savewatt.fr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "TREMENDOUS_BASE_URL": "https://api.tremendous.com/api/v2",
    "TREMENDOUS_FUNDING_SOURCE_ID": "BALANCE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "savewatt",
      "database_id": "f9966fb7-be92-497b-9e4a-b3444fc841d0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "savewatt-documents"
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "observability": {
    "enabled": true
  }
}
